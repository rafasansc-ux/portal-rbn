{
  "version": 2,
  "buildCommand": "node build-cloud.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/portal.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:route",
      "destination": "/api/portal?route=:route"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}